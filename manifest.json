{
  "manifest_version": 3,
  "name": "Cindra Summary",
  "version": "1.3.0",
  "minimum_chrome_version": "125",
  "description": "Summarize webpages, PDFs, YouTube videos, and Reddit threads with your preferred AI chat.",
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "offscreen",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "options_page": "ui/options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/providers.js",
        "content_scripts/lib/inject.js",
        "content_scripts/content.js"
      ]
    },
    {
      "matches": [
        "*://aistudio.google.com/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/ai_studio_content.js"
      ]
    },
    {
      "matches": [
        "*://*.perplexity.ai/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/perplexity_content.js"
      ]
    },
    {
      "matches": [
        "*://grok.com/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/grok_content.js"
      ]
    },
    {
      "matches": [
        "*://claude.ai/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/claude_content.js"
      ]
    },
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://chat.com/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/chatgpt_content.js"
      ]
    },
    {
      "matches": [
        "https://gemini.google.com/app/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/gemini_content.js"
      ]
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content_scripts/lib/youtube_parser.js",
        "content_scripts/youtube_content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "content_scripts/reddit_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://learning.google.com/experiments/learn-about*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/google_learning_content.js"
      ]
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/deepseek_content.js"
      ]
    },
    {
      "matches": [
        "https://chat.z.ai/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/glm_content.js"
      ]
    },
    {
      "matches": [
        "https://kimi.com/*",
        "https://www.kimi.com/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/kimi_content.js"
      ]
    },
    {
      "matches": [
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/huggingchat_content.js"
      ]
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/qwen_content.js"
      ]
    },
    {
      "matches": [
        "https://chat.cerebras.ai/*",
        "https://cloud.cerebras.ai/*"
      ],
      "js": [
        "content_scripts/lib/inject.js",
        "content_scripts/lib/provider_runtime.js",
        "content_scripts/cerebras_content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "vendor/pdfjs/pdf.min.mjs",
        "vendor/pdfjs/pdf.worker.min.mjs",
        "vendor/pdfjs/cmaps/*",
        "vendor/pdfjs/standard_fonts/*",
        "vendor/pdfjs/wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
